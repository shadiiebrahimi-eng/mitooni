{
  "title": "Attempt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "testId": {
      "type": "string"
    },
    "testTitle": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "full",
        "section",
        "practice"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "exam",
        "practice"
      ]
    },
    "accommodation": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 1.25
        },
        {
          "type": "number",
          "const": 1.5
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "in-progress",
        "submitted"
      ]
    },
    "sectionIndex": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "not-started",
              "in-progress",
              "submitted"
            ]
          },
          "remainingSec": {
            "type": "number"
          },
          "currentPart": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "currentNumber": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "answers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "root": {
                  "type": "string"
                },
                "start": {
                  "type": "number"
                },
                "end": {
                  "type": "number"
                },
                "noteId": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "root",
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "quote",
                "text",
                "createdAt"
              ],
              "additionalProperties": false
            }
          },
          "essays": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "recordings": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "durationSec": {
                  "type": "number"
                }
              },
              "required": [
                "key",
                "durationSec"
              ],
              "additionalProperties": false
            }
          },
          "partTime": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "submittedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "sectionId",
          "status",
          "remainingSec",
          "currentPart",
          "currentNumber",
          "answers",
          "flags",
          "highlights",
          "notes",
          "essays",
          "recordings",
          "partTime",
          "startedAt",
          "submittedAt"
        ],
        "additionalProperties": false
      }
    },
    "startedAt": {
      "type": "string"
    },
    "submittedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "testId",
    "testTitle",
    "kind",
    "mode",
    "accommodation",
    "status",
    "sectionIndex",
    "sections",
    "startedAt",
    "submittedAt"
  ],
  "additionalProperties": false
}
