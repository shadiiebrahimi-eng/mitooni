{
  "title": "WritingFeedback",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "partId": {
      "type": "string"
    },
    "task": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "words": {
      "type": "number"
    },
    "essay": {
      "type": "string"
    },
    "band": {
      "type": "number",
      "minimum": 0,
      "maximum": 9,
      "multipleOf": 0.5
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "tr",
              "cc",
              "lr",
              "gra",
              "fc",
              "p"
            ]
          },
          "band": {
            "type": "number",
            "minimum": 0,
            "maximum": 9,
            "multipleOf": 0.5
          },
          "comment": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              },
              "fa": {
                "type": "string"
              }
            },
            "required": [
              "en",
              "fa"
            ],
            "additionalProperties": false
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string"
                    },
                    "fa": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "en",
                    "fa"
                  ],
                  "additionalProperties": false
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "needs-work",
                    "acceptable",
                    "good",
                    "strong"
                  ]
                },
                "note": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string"
                    },
                    "fa": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "en",
                    "fa"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "label",
                "score",
                "verdict",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "tips": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string"
                },
                "fa": {
                  "type": "string"
                }
              },
              "required": [
                "en",
                "fa"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "key",
          "band",
          "comment"
        ],
        "additionalProperties": false
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "grammar",
              "vocabulary",
              "cohesion",
              "task"
            ]
          },
          "note": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              },
              "fa": {
                "type": "string"
              }
            },
            "required": [
              "en",
              "fa"
            ],
            "additionalProperties": false
          },
          "fix": {
            "type": "string"
          }
        },
        "required": [
          "quote",
          "kind",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "fa": {
          "type": "string"
        }
      },
      "required": [
        "en",
        "fa"
      ],
      "additionalProperties": false
    },
    "dummy": {
      "type": "boolean"
    }
  },
  "required": [
    "partId",
    "task",
    "words",
    "essay",
    "band",
    "criteria",
    "annotations",
    "summary",
    "dummy"
  ],
  "additionalProperties": false
}
