{
  "title": "CoachState",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "coach": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "initials": {
          "type": "string"
        },
        "credentials": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string"
            },
            "fa": {
              "type": "string"
            }
          },
          "required": [
            "en",
            "fa"
          ],
          "additionalProperties": false
        },
        "bio": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string"
            },
            "fa": {
              "type": "string"
            }
          },
          "required": [
            "en",
            "fa"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "initials",
        "credentials",
        "bio"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "minutes": {
            "type": "number"
          },
          "booked": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "start",
          "minutes",
          "booked"
        ],
        "additionalProperties": false
      }
    },
    "bookings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "minutes": {
            "type": "number"
          },
          "booked": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "start",
          "minutes",
          "booked"
        ],
        "additionalProperties": false
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "essay",
              "recording"
            ]
          },
          "title": {
            "type": "string"
          },
          "attemptId": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "requested",
              "in-review",
              "returned"
            ]
          },
          "submittedAt": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "author": {
                  "type": "string",
                  "enum": [
                    "coach",
                    "me"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "at": {
                  "type": "string"
                }
              },
              "required": [
                "author",
                "text",
                "at"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "attemptId",
          "status",
          "submittedAt",
          "messages"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "coach",
    "slots",
    "bookings",
    "reviews"
  ],
  "additionalProperties": false
}
