                                "en": {
                                  "type": "string"
                                },
                                "fa": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "en",
                                "fa"
                              ],
                              "additionalProperties": false
                            },
                            "trap": {
                              "type": "object",
                              "properties": {
                                "en": {
                                  "type": "string"
                                },
                                "fa": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "en",
                                "fa"
                              ],
                              "additionalProperties": false
