{
  "title": "Dashboard",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "predicted": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0,
              "maximum": 9,
              "multipleOf": 0.5
            },
            "high": {
              "type": "number",
              "minimum": 0,
              "maximum": 9,
              "multipleOf": 0.5
            },
            "mocks": {
              "type": "number"
            },
            "questions": {
              "type": "number"
            }
          },
          "required": [
            "low",
            "high",
            "mocks",
            "questions"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string",
            "enum": [
              "listening",
              "reading",
              "writing",
              "speaking"
            ]
          },
          "band": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 9,
                "multipleOf": 0.5
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {
            "type": "number",
            "minimum": 0,
            "maximum": 9,
            "multipleOf": 0.5
          }
        },
        "required": [
          "skill",
          "band",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "readingTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "multiple-choice",
              "tfng",
              "ynng",
              "matching-information",
              "matching-headings",
              "matching-features",
              "matching-sentence-endings",
              "sentence-completion",
              "summary-completion",
              "note-completion",
              "table-completion",
              "flow-chart-completion",
              "diagram-label-completion",
              "short-answer",
              "matching",
              "plan-map-diagram-labelling",
              "form-completion"
            ]
          },
          "accuracy": {
            "type": "number"
          },
          "strength": {
            "type": "string",
            "enum": [
              "weakness",
              "fair",
              "strength"
            ]
          }
        },
        "required": [
          "type",
          "accuracy",
          "strength"
        ],
        "additionalProperties": false
      }
    },
    "focus": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "multiple-choice",
                "tfng",
                "ynng",
                "matching-information",
                "matching-headings",
                "matching-features",
                "matching-sentence-endings",
                "sentence-completion",
                "summary-completion",
                "note-completion",
                "table-completion",
                "flow-chart-completion",
                "diagram-label-completion",
                "short-answer",
                "matching",
                "plan-map-diagram-labelling",
                "form-completion"
              ]
            },
            "marksLost": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "marksLost"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "trend": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "band": {
            "type": "number",
            "minimum": 0,
            "maximum": 9,
            "multipleOf": 0.5
          },
          "attemptId": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "band",
          "attemptId"
        ],
        "additionalProperties": false
      }
    },
    "next": {
      "type": "object",
      "properties": {
        "title": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string"
            },
            "fa": {
              "type": "string"
            }
          },
          "required": [
            "en",
            "fa"
          ],
          "additionalProperties": false
        },
        "detail": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string"
            },
            "fa": {
              "type": "string"
            }
          },
          "required": [
            "en",
            "fa"
          ],
          "additionalProperties": false
        },
        "href": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "detail",
        "href"
      ],
      "additionalProperties": false
    },
    "nextMock": {
      "type": [
        "string",
        "null"
      ]
    },
    "pacing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "listening",
              "reading",
              "writing1",
              "writing2"
            ]
          },
          "ratio": {
            "type": "number"
          },
          "label": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              },
              "fa": {
                "type": "string"
              }
            },
            "required": [
              "en",
              "fa"
            ],
            "additionalProperties": false
          },
          "over": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "ratio",
          "label",
          "over"
        ],
        "additionalProperties": false
      }
    },
    "pacingNote": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "fa": {
          "type": "string"
        }
      },
      "required": [
        "en",
        "fa"
      ],
      "additionalProperties": false
    },
    "writing": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "attemptId": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "tr",
                      "cc",
                      "lr",
                      "gra",
                      "fc",
                      "p"
                    ]
                  },
                  "band": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 9,
                    "multipleOf": 0.5
                  },
                  "comment": {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string"
                      },
                      "fa": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "en",
                      "fa"
                    ],
                    "additionalProperties": false
                  },
                  "metrics": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "object",
                          "properties": {
                            "en": {
                              "type": "string"
                            },
                            "fa": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "en",
                            "fa"
                          ],
                          "additionalProperties": false
                        },
                        "score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "verdict": {
                          "type": "string",
                          "enum": [
                            "needs-work",
                            "acceptable",
                            "good",
                            "strong"
                          ]
                        },
                        "note": {
                          "type": "object",
                          "properties": {
                            "en": {
                              "type": "string"
                            },
                            "fa": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "en",
                            "fa"
                          ],
                          "additionalProperties": false
                        },
                        "example": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "key",
                        "label",
                        "score",
                        "verdict",
                        "note"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "tips": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        },
                        "fa": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "en",
                        "fa"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "key",
                  "band",
                  "comment"
                ],
                "additionalProperties": false
              }
            },
            "summary": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string"
                },
                "fa": {
                  "type": "string"
                }
              },
              "required": [
                "en",
                "fa"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "attemptId",
            "date",
            "criteria",
            "summary"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "daysToTest": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "predicted",
    "skills",
    "readingTypes",
    "focus",
    "trend",
    "next",
    "nextMock",
    "pacing",
    "pacingNote",
    "writing",
    "daysToTest"
  ],
  "additionalProperties": false
}
