{
  "title": "Profile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "fa"
      ]
    },
    "theme": {
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "targets": {
      "type": "object",
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 9,
          "multipleOf": 0.5
        },
        "listening": {
          "type": "number",
          "minimum": 0,
          "maximum": 9,
          "multipleOf": 0.5
        },
        "reading": {
          "type": "number",
          "minimum": 0,
          "maximum": 9,
          "multipleOf": 0.5
        },
        "writing": {
          "type": "number",
          "minimum": 0,
          "maximum": 9,
          "multipleOf": 0.5
        },
        "speaking": {
          "type": "number",
          "minimum": 0,
          "maximum": 9,
          "multipleOf": 0.5
        }
      },
      "required": [
        "overall",
        "listening",
        "reading",
        "writing",
        "speaking"
      ],
      "additionalProperties": false
    },
    "testDate": {
      "type": [
        "string",
        "null"
      ]
    },
    "currentLevel": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 9,
          "multipleOf": 0.5
        },
        {
          "type": "null"
        }
      ]
    },
    "weeklyHours": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "accommodation": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 1.25
        },
        {
          "type": "number",
          "const": 1.5
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "showFlag": {
      "type": "boolean"
    },
    "onboarded": {
      "type": "boolean"
    },
    "scheduledMock": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan": {
      "type": "string",
      "enum": [
        "standard",
        "coach"
      ]
    },
    "notifications": {
      "type": "object",
      "properties": {
        "email": {
          "type": "boolean"
        },
        "reminders": {
          "type": "boolean"
        }
      },
      "required": [
        "email",
        "reminders"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "email",
    "locale",
    "theme",
    "targets",
    "testDate",
    "currentLevel",
    "weeklyHours",
    "accommodation",
    "showFlag",
    "onboarded",
    "scheduledMock",
    "plan",
    "notifications"
  ],
  "additionalProperties": false
}
