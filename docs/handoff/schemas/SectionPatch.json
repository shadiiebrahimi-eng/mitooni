{
  "title": "SectionPatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sectionId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not-started",
        "in-progress",
        "submitted"
      ]
    },
    "remainingSec": {
      "type": "number"
    },
    "currentPart": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "currentNumber": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "answers": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "noteId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "root",
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "quote",
          "text",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "essays": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "recordings": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "durationSec": {
            "type": "number"
          }
        },
        "required": [
          "key",
          "durationSec"
        ],
        "additionalProperties": false
      }
    },
    "partTime": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "submittedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "sectionId"
  ],
  "additionalProperties": false
}
