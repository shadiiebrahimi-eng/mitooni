{
  "title": "ResultSummary",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attemptId": {
      "type": "string"
    },
    "testTitle": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "full",
        "section",
        "practice"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "exam",
        "practice"
      ]
    },
    "completedAt": {
      "type": "string"
    },
    "overall": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 9,
          "multipleOf": 0.5
        },
        {
          "type": "null"
        }
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string",
            "enum": [
              "listening",
              "reading",
              "writing",
              "speaking"
            ]
          },
          "raw": {
            "type": [
              "number",
              "null"
            ]
          },
          "total": {
            "type": [
              "number",
              "null"
            ]
          },
          "band": {
            "type": "number",
            "minimum": 0,
            "maximum": 9,
            "multipleOf": 0.5
          },
          "usedSec": {
            "type": "number"
          },
          "allowedSec": {
            "type": "number"
          }
        },
        "required": [
          "skill",
          "raw",
          "total",
          "band",
          "usedSec",
          "allowedSec"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "attemptId",
    "testTitle",
    "kind",
    "mode",
    "completedAt",
    "overall",
    "skills"
  ],
  "additionalProperties": false
}
